# Salin ke /opt/miru-staging/.env — jangan commit file .env asli.

SECRET_KEY=generate-django-secret-key
DEBUG=False
ALLOWED_HOSTS=api.dev.mirubanksampah.id,dev.mirubanksampah.id,localhost

USE_POSTGRES=True
DB_NAME=miru_staging
DB_USER=miru
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://dev.mirubanksampah.id

# MinIO — CI menambahkan baris ini otomatis jika belum ada
MINIO_ROOT_USER=miru_staging
MINIO_ROOT_PASSWORD=change-me-openssl-rand-hex-16
MINIO_ACCESS_KEY=miru_staging
MINIO_SECRET_KEY=change-me-same-or-separate
MINIO_BUCKET=mirubanksampah
MINIO_REGION=us-east-1

# Web admin (build-time di image; opsional di .env root)
NEXT_PUBLIC_API_URL=https://api.dev.mirubanksampah.id
NEXT_PUBLIC_APP_NAME=MIRU Bank Sampah (Staging)
