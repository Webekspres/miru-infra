# Salin ke /opt/miru-prod/.env — jangan commit file .env asli.
# Production stack di-deploy dari branch `main` infra. Env example ini
# adalah acuan; nilai diputuskan operator saat setup sekali pakai.

SECRET_KEY=generate-django-secret-key
DEBUG=False
ALLOWED_HOSTS=api.mirubanksampah.id,mirubanksampah.id,localhost

USE_POSTGRES=True
DB_NAME=miru_prod
DB_USER=miru
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://admin.mirubanksampah.id,https://mirubanksampah.id

# Domain cookie auth web admin — WAJIB punya APEX (tanpa subdomain) supaya
# cookie HttpOnly yang di-set backend di api.mirubanksampah.id ikut terkirim
# ke panel admin di admin.mirubanksampah.id. Tanpa ini admin web selalu
# di-redirect balik ke /login sebelum sempat autentikasi.
COOKIE_DOMAIN=mirubanksampah.id

# MinIO — aplikasi memakai kredensial terpisah (scoped ke bucket), bukan root.
MINIO_ROOT_USER=miru_prod
MINIO_ROOT_PASSWORD=change-me-openssl-rand-hex-16
MINIO_ACCESS_KEY=miru_prod_app
MINIO_SECRET_KEY=change-me-separate-from-root
MINIO_BUCKET=mirubanksampah
MINIO_REGION=us-east-1

# WhatsApp OTP gateway
# WA_API_URL=
# WA_API_TOKEN=
# WA_SENDER=

# Jaga False secara permanent di production — OTP wajib jalan.
SKIP_PHONE_VERIFICATION=False

# Image immutable (hash SHA256) — di-set otomatis oleh CI saat deploy.
# Jangan pakai :latest di production.
# API_IMAGE_TAG=
# ADMIN_IMAGE_TAG=

# Web admin (build-time di image; opsional di .env root)
NEXT_PUBLIC_API_URL=https://api.mirubanksampah.id
NEXT_PUBLIC_APP_NAME=MIRU Bank Sampah